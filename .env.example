# Copy to .env before `docker compose up`. Never commit the real .env.

POSTGRES_USER=sanjeevani
POSTGRES_PASSWORD=sanjeevani
POSTGRES_DB=sanjeevani
POSTGRES_PORT=5433

API_PORT=4000
WEB_PORT=3000

# Sign your own. Any long random string works for local dev.
JWT_SECRET=dev-only-change-me

# Comma-separated Google OAuth client IDs that are allowed to mint a session.
# Add every platform you build for (android, ios, web) from Google Cloud Console.
# Leave empty to disable Google sign-in; email/password still works.
GOOGLE_CLIENT_IDS=

# --- AI / triage layer (owned by another team) -------------------------------
# Unset  -> the backend answers with a local stub so the app is fully demoable.
# Set    -> the backend POSTs the triage contract to this URL.
AI_SERVICE_URL=
AI_SERVICE_TOKEN=
# Shared secret the AI service sends as `x-ai-secret` on POST /ai/triage-callback.
AI_CALLBACK_SECRET=dev-callback-secret

CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
