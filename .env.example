# Copy to .env before `docker compose up`. Never commit the real .env.

POSTGRES_USER=sanjeevani
POSTGRES_PASSWORD=sanjeevani
POSTGRES_DB=sanjeevani
POSTGRES_PORT=5433

API_PORT=4000
WEB_PORT=3000

# Required -- the backend refuses to start without it, on every run path.
# Generate one:  node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=

# Comma-separated Google OAuth client IDs that are allowed to mint a session.
# Add every platform you build for (android, ios, web) from Google Cloud Console.
# Leave empty to disable Google sign-in; email/password still works.
GOOGLE_CLIENT_IDS=

# --- AI / triage layer (owned by another team) -------------------------------
# Unset  -> the backend answers with a local stub so the app is fully demoable.
# Set    -> the backend POSTs the triage contract to this URL.
AI_SERVICE_URL=
AI_SERVICE_TOKEN=
# Shared secret the AI service sends as `x-ai-secret` on POST /ai/triage-callback.
# This header is the only thing guarding /ai/*, which can read pending triage
# payloads and write results into a patient's chat. Generate it like JWT_SECRET.
# Leave empty to refuse every /ai/* call.
AI_CALLBACK_SECRET=

CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Demo hospitals, departments, and the seeded accounts in db/seed.sql. Set false
# for any instance holding real patients: the demo staff accounts share one
# well-known password. Only has an effect on a first boot / after `down -v`.
SEED_DEMO_DATA=true
