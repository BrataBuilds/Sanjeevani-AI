# Copy to .env before `docker compose up`. Never commit the real .env.

POSTGRES_USER=sanjeevani
POSTGRES_PASSWORD=sanjeevani
POSTGRES_DB=sanjeevani
POSTGRES_PORT=5433

API_PORT=4000
WEB_PORT=3000

# Required -- the backend refuses to start without it, on every run path.
# Generate one:  node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=

# Comma-separated Google OAuth client IDs that are allowed to mint a session.
# Add every platform you build for (android, ios, web) from Google Cloud Console.
# Leave empty to disable Google sign-in; email/password still works.
GOOGLE_CLIENT_IDS=

# The *web* OAuth client id, compiled into the patient app so the Google plugin
# can ask for an ID token. Must also appear in GOOGLE_CLIENT_IDS above, or the
# backend will reject the token it produces.
GOOGLE_SERVER_CLIENT_ID=

# --- the first hospital administrator ----------------------------------------
# Doctors are created by an admin and admins by another admin, which leaves no
# way to make the first one. These three provision it at boot, and the account is
# reconciled against them on every start -- rotate the password here and restart.
# Leave all three empty to skip (an instance that already has its admins).
#
# ADMIN_EMAIL must not already belong to a patient or doctor; the server refuses
# to start rather than promote an existing account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_HOSPITAL=

# --- Firebase Authentication -------------------------------------------------
# Your Firebase project id (console -> Project settings -> General). That is ALL
# the backend needs: a Firebase ID token is an RS256 JWT signed by a well-known
# Google key, so it is verified against Google's public certificates.
#
# No service-account key is required, and none should be added. One would only
# buy Admin operations (custom claims, user management) this repo does not use,
# and roles live in our own users table. Leave empty to disable Firebase sign-in.
FIREBASE_PROJECT_ID=

# --- Firebase client config (compiled into the patient app) ------------------
# Firebase console -> Project settings -> Your apps -> Web app -> SDK setup.
# Public values: they ship inside every client build regardless, and access is
# enforced by the backend verifying the ID token against FIREBASE_PROJECT_ID.
# API_KEY, APP_ID, MESSAGING_SENDER_ID and FIREBASE_PROJECT_ID must all be set
# or the app hides the sign-in button.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
# Optional, defaults to <FIREBASE_PROJECT_ID>.firebaseapp.com
FIREBASE_AUTH_DOMAIN=

# --- AI / triage layer (owned by another team) -------------------------------
# Unset  -> the backend answers with a local stub so the app is fully demoable.
# Set    -> the backend POSTs the triage contract to this URL.
AI_SERVICE_URL=
AI_SERVICE_TOKEN=

# The staff console and the Flutter web build. Both origins must be listed or the
# browser blocks every request.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
NEXT_PUBLIC_API_URL=http://localhost:4000

# Ports published by `bash run.sh` / `docker compose up`.
APP_WEB_PORT=8081
RAG_PORT=8000

# Compiled into the Flutter web bundle. The browser runs on your machine, so this is
# the host's published API port, not the compose service name.
PUBLIC_API_URL=http://localhost:4000

# Only for the `ai` profile (`bash run.sh --profile ai`). The AI team's service
# refuses to start without it. Leave empty otherwise; the backend's stub covers the
# whole demo.
GEMINI_API=

# Demo hospitals, departments and accounts from db/seed.sql. OFF by default: every
# seeded account shares one password published in this repository, so loading it
# on a reachable host hands out a hospital-admin session to anyone who reads it.
# Set true only for a local demo. Only has an effect on a first boot / after
# `down -v`; use ADMIN_* above to provision a real administrator instead.
SEED_DEMO_DATA=false

# Which Gemini model the triage agent runs on. The default Gemma model does not
# handle tool use plus structured output reliably -- turns intermittently come
# back naming an action with its payload missing. A function-calling model such
# as gemini-2.0-flash removes that failure mode.
GEMINI_MODEL=
