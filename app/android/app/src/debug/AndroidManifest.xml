<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug builds talk to a plain-http dev API (10.0.2.2:4000 from the emulator).
         Deliberately debug-only: release builds keep Android's cleartext block, so a
         production deployment has to be served over HTTPS. -->
    <application android:usesCleartextTraffic="true" tools:replace="android:usesCleartextTraffic"
        xmlns:tools="http://schemas.android.com/tools" />
</manifest>
